{
  "name": "basecoat-ui-mcp",
  "displayName": "Basecoat UI MCP",
  "version": "1.7.1",
  "description": "Offline MCP server for Basecoat UI (shadcn/ui look without React): 4-Stage Intent-Driven Tooling Layer, Kanso design direction, and WCAG 2.1/APCA quality inspection.",
  "author": {
    "name": "Žygimantas Jasiulionis / Intellmedia",
    "url": "https://github.com/zygiu-zygis/basecoat-ui-mcp"
  },
  "license": "MIT",
  "repository": "https://github.com/zygiu-zygis/basecoat-ui-mcp",
  "rules": [
    ".cursor/rules/basecoat.mdc",
    "templates/cursor/basecoat-designer.mdc"
  ],
  "mcpServers": {
    "basecoat-ui": {
      "command": "node",
      "args": [
        "${pluginRoot}/dist/server/stdio.js",
        "--project-root",
        "${workspaceFolder}"
      ],
      "transport": "stdio"
    }
  }
}

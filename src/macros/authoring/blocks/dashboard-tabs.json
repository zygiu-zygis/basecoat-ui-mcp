    { "id": "past-performance", "at": { "fragment": "tabs-root", "name": "past-performance" }, "accepts": ["tab-panel"], "min": 0, "max": 1 },
    { "id": "key-personnel", "at": { "fragment": "tabs-root", "name": "key-personnel" }, "accepts": ["tab-panel"], "min": 0, "max": 1 },
    { "id": "focus-documents", "at": { "fragment": "tabs-root", "name": "focus-documents" }, "accepts": ["tab-panel"], "min": 0, "max": 1 }
  ],
  "ports": [],
  "componentRefs": ["tabs", "button"],
  "ruleRefs": [],
  "dependencyBlockIds": [],

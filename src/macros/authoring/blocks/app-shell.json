{
  "schemaVersion": 1,
  "id": "app-shell",
  "role": "shell",
  "family": "layout",
  "description": "Reference dashboard shell contract: 16rem sidebar, 4rem header, 1rem desktop content gutter, 1rem mobile gutter; sidebar collapses below md and the content frame owns scrolling.",
  "tags": ["shell", "layout", "workspace"],
  "root": "shell-root",
  "fragments": [
    {
      "id": "shell-root",
      "emmet": "div.flex.min-h-screen.w-full.bg-background.text-foreground[data-theme-tokens=bg-background,text-foreground,border-border][data-sidebar-width=16rem][data-mobile-breakpoint=md][data-content-gutter=1rem][data-horizontal-overflow=contained]>div.sidebar-backdrop.fixed.inset-0.z-30.hidden.bg-black/50.data-[state=open]:block.md:hidden[data-sidebar-backdrop][aria-hidden=true]+aside[data-slot=nav]+div.flex.min-w-0.flex-1.flex-col.>header.flex.items-center.justify-between.gap-4.border-b.border-border.p-4[data-slot=header][data-height=4rem]+main#main.flex-1.min-w-0[data-slot=content][data-scroll-owner=main][data-width=fluid]"
    }
  ],
  "mounts": [],
  "slots": [
    { "id": "navigation", "at": { "fragment": "shell-root", "name": "nav" }, "accepts": ["navigation"], "min": 0, "max": 1 },
    { "id": "header", "at": { "fragment": "shell-root", "name": "header" }, "accepts": ["header"], "min": 0, "max": 1 },
    { "id": "content", "at": { "fragment": "shell-root", "name": "content" }, "accepts": ["workspace", "hero", "page", "dashboard"], "min": 1, "max": 1 }
  ],
  "ports": [
    { "id": "main-region", "at": { "fragment": "shell-root", "name": "shell-root" }, "direction": "out", "kind": "region", "contract": "main", "minLinks": 0, "maxLinks": 1, "scope": "page" }
  ],
  "componentRefs": [],
  "ruleRefs": [],
  "dependencyBlockIds": [],
  "layout": { "frameRef": "shell-root" },
  "landmarks": { "main": 0, "primaryHeading": 0 },
  "provenance": { "origin": "authored", "sourceHashes": {}, "mappingVersion": "1.0.0" }
}

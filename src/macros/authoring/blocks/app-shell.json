{
  "schemaVersion": 1,
  "id": "app-shell",
  "role": "shell",
  "family": "layout",
  "description": "Application shell with navigation, header, and main content slots.",
  "tags": ["shell", "layout", "workspace"],
  "root": "shell-root",
  "fragments": [
    {
      "id": "shell-root",
      "emmet": "div.flex.min-h-screen.bg-background>aside[data-slot=nav]+div.flex.flex-1.flex-col>header[data-slot=header]+main#main[data-slot=content]"
    }
  ],
  "mounts": [],
  "slots": [
    {
      "id": "navigation",
      "at": { "fragment": "shell-root", "name": "nav" },
      "accepts": ["navigation"],
      "min": 1,
      "max": 1,
      "boundary": "shell-root"
    },
    {
      "id": "header",
      "at": { "fragment": "shell-root", "name": "header" },
      "accepts": ["header"],
      "min": 1,
      "max": 1
    },
    {
      "id": "content",
      "at": { "fragment": "shell-root", "name": "content" },
      "accepts": ["page", "workspace", "dashboard"],
      "min": 1,
      "max": 1,
      "boundary": "shell-root"
    }
  ],
  "ports": [
    {
      "id": "nav-control",
      "at": { "fragment": "shell-root", "name": "nav" },
      "direction": "out",
      "kind": "control",
      "contract": "nav-toggle",
      "minLinks": 0,
      "maxLinks": 1,
      "scope": "shell"
    },
    {
      "id": "main-region",
      "at": { "fragment": "shell-root", "name": "content" },
      "direction": "out",
      "kind": "region",
      "contract": "main",
      "minLinks": 0,
      "maxLinks": 4,
      "scope": "shell"
    }
  ],
  "componentRefs": [],
  "ruleRefs": ["shell-frame", "shell-gutter"],
  "dependencyBlockIds": [],
  "layout": {
    "frameRef": "shell-root",
    "gutterBoundary": "shell-root",
    "scrollBoundary": "shell-root"
  },
  "landmarks": { "main": 0, "primaryHeading": 0 },
  "provenance": {
    "origin": "authored",
    "sourceHashes": {},
    "mappingVersion": "1.0.0"
  }
}

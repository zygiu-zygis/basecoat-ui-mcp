{
  "schemaVersion": 1,
  "id": "dashboard-activity",
  "role": "activity",
  "family": "workspace",
  "description": "Reference activity contract: 24rem chart panel, 3-month default range, mobile and desktop series, visible legend and tooltip hooks, and loading/empty/error states. Controls wrap below md.",
  "tags": ["dashboard", "chart", "activity", "responsive", "states", "offline"],
  "root": "activity-root",
  "fragments": [
    {
      "id": "activity-root",
      "emmet": "section.card.flex.min-w-0.flex-col.gap-6.rounded-xl.border.border-border.bg-card.py-6.text-card-foreground.shadow-sm[data-slot=activity-panel][data-state=ready][data-height=24rem]>(header.flex.flex-col.items-start.justify-between.gap-4.px-6.md:flex-row.md:items-center>div.grid.gap-2>h2.text-base.font-semibold[data-slot=title]{Total Visitors}+p.text-sm.text-muted-foreground[data-slot=subtitle]{Total for the last 3 months}^div.flex.w-full.items-center.md:w-auto[data-slot=range][data-default-range=3m][data-responsive=wrap-below-md])+div.px-2.sm:px-6[data-component=chart][data-slot=chart][data-series=mobile,desktop][data-series-density=dense-apr-jun][data-tooltip=enabled][data-legend=mobile,desktop]"
    }
  ],
  "mounts": [],
  "slots": [
    { "id": "range", "at": { "fragment": "activity-root", "name": "range" }, "accepts": ["range-control"], "min": 0, "max": 1 },
    { "id": "chart", "at": { "fragment": "activity-root", "name": "chart" }, "accepts": ["chart"], "min": 0, "max": 1 }
  ],
  "ports": [
    { "id": "activity-in", "at": { "fragment": "activity-root", "name": "activity-root" }, "direction": "in", "kind": "region", "contract": "activity", "minLinks": 0, "maxLinks": 1, "scope": "page" }
  ],
  "componentRefs": ["chart"],
  "ruleRefs": [],
  "dependencyBlockIds": ["segmented-toggle", "svg-area-chart"],
  "layout": { "frameRef": "activity-root" },
  "landmarks": { "main": 0, "primaryHeading": 0 },
  "provenance": { "origin": "authored", "sourceHashes": {}, "mappingVersion": "1.0.0" }
}

{
  "schemaVersion": 1,
  "id": "page-header",
  "role": "header",
  "family": "layout",
  "description": "Reference dashboard header contract: 4rem tall, 1rem horizontal gutter, breadcrumb/title on the left and actions on the right; menu toggle is available below md.",
  "tags": ["header", "breadcrumb"],
  "root": "content-frame",
  "fragments": [
    {
      "id": "content-frame",
      "emmet": "header.flex.h-12.items-center.justify-between.gap-2.border-b.border-border.px-4.lg:px-6[data-slot=header][data-height=3rem][data-gutter=1rem][data-responsive=wrap-below-md]>div.flex.items-center.gap-2>button.btn.btn-ghost.size-7[data-slot=sidebar-trigger][aria-label='Toggle Sidebar']+div.w-px.h-4.bg-border[role=none]+h1.text-base.font-medium[data-slot=title]{Documents}^div.flex.items-center.gap-2[data-slot=actions]"
    }
  ],
  "mounts": [],
  "slots": [
    {
      "id": "actions",
      "at": { "fragment": "content-frame", "name": "actions" },
      "accepts": ["action"],
      "min": 0,
      "max": 4
    }
  ],
  "ports": [
    {
      "id": "nav-toggle-out",
      "at": { "fragment": "content-frame", "name": "content-frame" },
      "direction": "out",
      "kind": "control",
      "contract": "nav-toggle",
      "minLinks": 0,
      "maxLinks": 1,
      "scope": "shell"
    }
  ],
  "componentRefs": ["breadcrumb", "button"],
  "ruleRefs": [],
  "dependencyBlockIds": [],
  "layout": { "frameRef": "content-frame" },
  "landmarks": { "main": 0, "primaryHeading": 1 },
  "provenance": {
    "origin": "authored",
    "sourceHashes": {},
    "mappingVersion": "1.0.0"
  }
}

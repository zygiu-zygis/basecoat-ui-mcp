{
  "schemaVersion": 1,
  "id": "dashboard-main",
  "role": "metrics",
  "family": "workspace",
  "description": "Reference KPI contract: four equal cards, 1/2/4 columns at base/md/xl, 1rem grid gap, 8rem minimum card height.",
  "tags": ["dashboard", "cards", "metrics", "kpi", "responsive", "states"],
  "root": "content-frame",
  "fragments": [
    {
      "id": "content-frame",
      "emmet": "section.grid.grid-cols-1.gap-4.p-4.md:grid-cols-2.xl:grid-cols-4[data-slot=metrics-grid][data-columns=1,2,4][data-card-min-height=8rem]>article.card.flex.min-h-32.min-w-0.flex-col.rounded-xl.border.border-border.bg-card.text-card-foreground.shadow-sm[data-slot=card-$]*4>header.flex.flex-row.items-center.justify-between.gap-2.p-6.pb-2>span.text-sm.font-medium[data-slot=label]+span.badge.rounded-full.border.border-border.px-2..text-[10px].text-muted-foreground[data-slot=delta]^section.flex.flex-col.gap-2.p-6.pt-0>strong.text-2xl.font-bold[data-slot=value]+p.text-xs.text-muted-foreground[data-slot=helper]"
    }
  ],
  "mounts": [],
  "slots": [
    { "id": "card-1", "at": { "fragment": "content-frame", "name": "card-1" }, "accepts": ["kpi"], "min": 0, "max": 1 },
    { "id": "card-2", "at": { "fragment": "content-frame", "name": "card-2" }, "accepts": ["kpi"], "min": 0, "max": 1 },
    { "id": "card-3", "at": { "fragment": "content-frame", "name": "card-3" }, "accepts": ["kpi"], "min": 0, "max": 1 },
    { "id": "card-4", "at": { "fragment": "content-frame", "name": "card-4" }, "accepts": ["kpi"], "min": 0, "max": 1 }
  ],
  "ports": [
    { "id": "metrics-in", "at": { "fragment": "content-frame", "name": "content-frame" }, "direction": "in", "kind": "region", "contract": "metrics", "minLinks": 0, "maxLinks": 1, "scope": "page" }
  ],
  "componentRefs": ["card", "button"],
  "ruleRefs": [],
  "dependencyBlockIds": [],
  "layout": { "frameRef": "content-frame" },
  "landmarks": { "main": 0, "primaryHeading": 0 },
  "provenance": { "origin": "authored", "sourceHashes": {}, "mappingVersion": "1.0.0" }
}

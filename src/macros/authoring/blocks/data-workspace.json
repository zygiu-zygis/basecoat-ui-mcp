{
  "schemaVersion": 1,
  "id": "data-workspace",
  "role": "workspace",
  "family": "data",
  "description": "Reference records frame contract: tabs, filters, compact table, row actions, pager, and optional reviewer detail drawer. Region names must be tabs, filters, table, row-actions, pager, detail-drawer; records are {id,header,sectionType,status,target,limit,reviewer}; preserve selection, pagination, loading/empty/error states.",
  "tags": ["data", "workspace", "table", "tabs", "row-actions", "drawer", "responsive", "states"],
  "root": "content-frame",
  "fragments": [
    {
      "id": "content-frame",
      "emmet": "section.flex.flex-col.gap-6.px-4.lg:px-6[data-role=records-workspace][data-density=compact][data-responsive=stack-below-md]>div[data-slot=tabs]+div[data-slot=filters]+div[data-slot=table][data-state=ready]+div[data-slot=row-actions]+div[data-slot=pager]+div[data-slot=detail-drawer][data-state=closed][data-reviewer=enabled]"
    }
  ],
  "mounts": [],
  "slots": [
    {
      "id": "tabs",
      "at": { "fragment": "content-frame", "name": "tabs" },
      "accepts": ["tabs"],
      "min": 1,
      "max": 1
    },
    {
      "id": "filters",
      "at": { "fragment": "content-frame", "name": "filters" },
      "accepts": ["filters"],
      "min": 1,
      "max": 1
    },
    {
      "id": "table",
      "at": { "fragment": "content-frame", "name": "table" },
      "accepts": ["table"],
      "min": 1,
      "max": 1
    },
    {
      "id": "pager",
      "at": { "fragment": "content-frame", "name": "pager" },
      "accepts": ["pager"],
      "min": 1,
      "max": 1
    },
    {
      "id": "row-actions",
      "at": { "fragment": "content-frame", "name": "row-actions" },
      "accepts": ["row-action"],
      "min": 0,
      "max": 1
    },
    {
      "id": "detail-drawer",
      "at": { "fragment": "content-frame", "name": "detail-drawer" },
      "accepts": ["details"],
      "min": 0,
      "max": 1
    }
  ],
  "ports": [
    {
      "id": "main-in",
      "at": { "fragment": "content-frame", "name": "content-frame" },
      "direction": "in",
      "kind": "region",
      "contract": "main",
      "minLinks": 0,
      "maxLinks": 1,
      "scope": "shell"
    }
  ],
  "componentRefs": [],
  "ruleRefs": ["data-shared"],
  "dependencyBlockIds": ["data-filters", "data-table", "data-pager"],
  "layout": {
    "frameRef": "content-frame",
    "scrollBoundary": "content-frame"
  },
  "landmarks": { "main": 1, "primaryHeading": 0 },
  "provenance": {
    "origin": "authored",
    "sourceHashes": {},
    "mappingVersion": "1.0.0"
  }
}

{
  "schemaVersion": 1,
  "id": "data-records",
  "kind": "page",
  "profile": "app-default",
  "entryPage": "records",
  "routeLinks": [],
  "pages": [
    {
      "id": "records",
      "route": "/data",
      "recipe": "data-records",
      "root": "shell",
      "status": "plan-ready",
      "decisions": { "density": "compact" },
      "nodes": {
        "shell": {
          "id": "shell",
          "block": "app-shell",
          "bindings": {}
        },
        "nav": {
          "id": "nav",
          "block": "sidebar-nav",
          "parent": { "node": "shell", "slot": "navigation", "order": 0 },
          "bindings": {}
        },
        "header": {
          "id": "header",
          "block": "page-header",
          "parent": { "node": "shell", "slot": "header", "order": 0 },
          "bindings": {}
        },
        "workspace": {
          "id": "workspace",
          "block": "data-workspace",
          "parent": { "node": "shell", "slot": "content", "order": 0 },
          "bindings": { "data-context": "records-dataset" }
        },
        "filters": {
          "id": "filters",
          "block": "data-filters",
          "parent": { "node": "workspace", "slot": "filters", "order": 0 },
          "bindings": { "data-context": "records-dataset" }
        },
        "table": {
          "id": "table",
          "block": "data-table",
          "parent": { "node": "workspace", "slot": "table", "order": 1 },
          "bindings": { "data-context": "records-dataset" }
        },
        "pager": {
          "id": "pager",
          "block": "data-pager",
          "parent": { "node": "workspace", "slot": "pager", "order": 2 },
          "bindings": { "data-context": "records-dataset" }
        }
      },
      "connections": [
        {
          "id": "shell-to-workspace",
          "relation": "controls",
          "from": { "node": "shell", "port": "main-region" },
          "to": { "node": "workspace", "port": "main-in" }
        },
        {
          "id": "header-to-nav",
          "relation": "controls",
          "from": { "node": "header", "port": "nav-toggle-out" },
          "to": { "node": "nav", "port": "nav-toggle-in" }
        },
        {
          "id": "filters-to-table",
          "relation": "data",
          "from": { "node": "filters", "port": "dataset-out" },
          "to": { "node": "table", "port": "dataset-in" }
        },
        {
          "id": "filters-to-pager",
          "relation": "data",
          "from": { "node": "filters", "port": "dataset-out" },
          "to": { "node": "pager", "port": "dataset-in" }
        }
      ],
      "rules": [
        {
          "id": "records-shared-data",
          "type": "shared-data",
          "binding": "records-dataset",
          "nodes": ["filters", "table", "pager"]
        },
        {
          "id": "records-shell-frame",
          "type": "same-frame",
          "nodes": ["header", "workspace"]
        },
        {
          "id": "records-same-shell",
          "type": "same-shell",
          "nodes": ["nav", "header", "workspace"]
        }
      ]
    }
  ]
}

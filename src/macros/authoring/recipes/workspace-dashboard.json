{
  "schemaVersion": 1,
  "id": "workspace-dashboard",
  "kind": "page",
  "profile": "app-default",
  "entryPage": "dashboard",
  "routeLinks": [],
  "pages": [
    {
      "id": "dashboard",
      "route": "/workspace",
      "recipe": "workspace-dashboard",
      "root": "shell",
      "status": "plan-ready",
      "decisions": { "density": "comfortable", "nav-collapsed": false },
      "nodes": {
        "shell": {
          "id": "shell",
          "block": "app-shell",
          "bindings": {}
        },
        "nav": {
          "id": "nav",
          "block": "sidebar-dashboard-shell",
          "parent": { "node": "shell", "slot": "navigation", "order": 0 },
          "bindings": {}
        },
        "header": {
          "id": "header",
          "block": "page-header",
          "parent": { "node": "shell", "slot": "header", "order": 0 },
          "bindings": {}
        },
        "canvas": {
          "id": "canvas",
          "block": "dashboard-workspace",
          "parent": { "node": "shell", "slot": "content", "order": 0 },
          "bindings": {}
        },
        "metrics": {
          "id": "metrics",
          "block": "dashboard-main",
          "parent": { "node": "canvas", "slot": "metrics", "order": 0 },
          "bindings": {}
        },
        "activity": {
          "id": "activity",
          "block": "dashboard-activity",
          "parent": { "node": "canvas", "slot": "activity", "order": 0 },
          "bindings": {}
        },
        "range": {
          "id": "range",
          "block": "segmented-toggle",
          "parent": { "node": "activity", "slot": "range", "order": 0 },
          "bindings": {}
        },
        "chart": {
          "id": "chart",
          "block": "svg-area-chart",
          "parent": { "node": "activity", "slot": "chart", "order": 0 },
          "bindings": {}
        },
        "records": {
          "id": "records",
          "block": "data-workspace",
          "parent": { "node": "canvas", "slot": "records", "order": 0 },
          "bindings": { "data-context": "records-dataset" }
        },
        "tabs": {
          "id": "tabs",
          "block": "dashboard-tabs",
          "parent": { "node": "records", "slot": "tabs", "order": 0 },
          "bindings": {}
        },
        "filters": {
          "id": "filters",
          "block": "data-filters",
          "parent": { "node": "records", "slot": "filters", "order": 0 },
          "bindings": { "data-context": "records-dataset" }
        },
        "table": {
          "id": "table",
          "block": "data-table",
          "parent": { "node": "records", "slot": "table", "order": 1 },
          "bindings": { "data-context": "records-dataset" }
        },
        "row-actions": {
          "id": "row-actions",
          "block": "dashboard-row-actions",
          "parent": { "node": "records", "slot": "row-actions", "order": 2 },
          "bindings": { "data-context": "records-dataset" }
        },
        "pager": {
          "id": "pager",
          "block": "data-pager",
          "parent": { "node": "records", "slot": "pager", "order": 3 },
          "bindings": { "data-context": "records-dataset" }
        },
        "drawer": {
          "id": "drawer",
          "block": "detail-drawer-panel",
          "parent": { "node": "records", "slot": "detail-drawer", "order": 4 },
          "bindings": { "data-context": "records-dataset" }
        }
      },
      "connections": [
        {
          "id": "shell-to-canvas",
          "relation": "controls",
          "from": { "node": "shell", "port": "main-region" },
          "to": { "node": "canvas", "port": "main-in" }
        },
        {
          "id": "header-to-nav",
          "relation": "controls",
          "from": { "node": "header", "port": "nav-toggle-out" },
          "to": { "node": "nav", "port": "nav-toggle-in" }
        },
        {
          "id": "filters-to-table",
          "relation": "data",
          "from": { "node": "filters", "port": "dataset-out" },
          "to": { "node": "table", "port": "dataset-in" }
        },
        {
          "id": "filters-to-pager",
          "relation": "data",
          "from": { "node": "filters", "port": "dataset-out" },
          "to": { "node": "pager", "port": "dataset-in" }
        },
        {
          "id": "actions-to-drawer",
          "relation": "data",
          "from": { "node": "row-actions", "port": "dataset-out" },
          "to": { "node": "drawer", "port": "dataset-in" }
        }
      ],
      "rules": [
        {
          "id": "dashboard-shell-frame",
          "type": "same-frame",
          "nodes": ["header", "canvas"]
        },
        {
          "id": "dashboard-same-shell",
          "type": "same-shell",
          "nodes": ["nav", "header", "canvas"]
        },
        {
          "id": "dashboard-content-order",
          "type": "ordered",
          "parent": "canvas",
          "slot": "records",
          "nodes": ["records"]
        },
        {
          "id": "dashboard-shell-gutter",
          "type": "single-owner",
          "boundary": "shell-root",
          "property": "gutter",
          "nodes": ["shell"]
        },
        {
          "id": "dashboard-records-shared-data",
          "type": "shared-data",
          "binding": "records-dataset",
          "nodes": ["filters", "table", "pager"]
        }
      ]
    }
  ]
}

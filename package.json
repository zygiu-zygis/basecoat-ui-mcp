{
  "name": "@intellmedia/basecoat-ui-mcp",
  "version": "1.6.3",
  "description": "Offline MCP server for Basecoat UI (shadcn/ui look without React): curated templates, macro layouts, theming/dark-mode guidance, and static validation (stdio, no runtime network)",
  "author": "Žygimantas Jasiulionis / Intellmedia",
  "maintainers": [
    "Žygimantas Jasiulionis / Intellmedia"
  ],
  "license": "MIT",
  "mcpName": "io.github.zygiu-zygis/basecoat-ui-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zygiu-zygis/basecoat-ui-mcp.git"
  },
  "homepage": "https://github.com/zygiu-zygis/basecoat-ui-mcp",
  "bugs": {
    "url": "https://github.com/zygiu-zygis/basecoat-ui-mcp/issues"
  },
  "bin": {
    "basecoat-ui-mcp": "dist/server/stdio.js"
  },
  "main": "dist/server/index.js",
  "types": "dist/server/index.d.ts",
  "keywords": [
    "basecoat-ui",
    "basecoat-css",
    "model-context-protocol",
    "mcp",
    "mcp-server",
    "cursor",
    "claude",
    "claude-code",
    "windsurf",
    "shadcn",
    "shadcn-ui",
    "astro",
    "html",
    "tailwind",
    "tailwindcss",
    "tailwind-css-4",
    "dark-mode",
    "design-system",
    "nextjs",
    "express",
    "ai-coding-tools",
    "ai-agents"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "assets/logo.svg",
    "tests",
    "!tests/fixtures/offline-dashboard",
    "templates",
    "tsconfig.json",
    "tsconfig.check.json",
    "README.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "server.json"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm run compile:semantics:check && npm run compile:blocks:check && npm test && git diff --check origin/main",
    "start": "node dist/server/stdio.js",
    "test": "npm run build && node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "sync": "node --import tsx scripts/sync.ts",
    "compile:blocks": "node --import tsx scripts/compile-blocks.ts",
    "compile:blocks:check": "node --import tsx scripts/compile-blocks.ts --check",
    "compile:semantics": "node --import tsx scripts/compile-semantics.ts",
    "compile:semantics:check": "node --import tsx scripts/compile-semantics.ts --check",
    "import:blocks": "node --import tsx scripts/import-blocks.ts",
    "release:check": "node --import tsx scripts/release-check.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  }
}
